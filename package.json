{
  "name": "cormark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Annotate web pages and copy the notes as a prompt for a coding agent.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "CORMARK_E2E=1 wxt build && playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "preact": "^11.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
